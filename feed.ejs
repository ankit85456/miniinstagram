<html>
<head>
  <title>Mini Instagram Feed</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      background: #fafafa;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 10px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 20px 0;
      padding: 15px;
      background: white;
      border-bottom: 1px solid #ddd;
    }
    .header h1 {
      font-size: 24px;
      color: #333;
    }
    .nav {
      display: flex;
      gap: 15px;
    }
    .nav a {
      text-decoration: none;
      color: #0061a3;
      font-weight: bold;
      padding: 8px 15px;
      border-radius: 5px;
      background: #f0f0f0;
    }
    .nav a:hover {
      background: #e0e0e0;
    }
    .post {
      background: white;
      margin: 10px 0;
      border: 1px solid #ddd;
      border-radius: 8px;
      overflow: hidden;
    }
    .post-header {
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #eee;
    }
    .post-header strong {
      color: #333;
    }
    .post-header span {
      color: #999;
      font-size: 12px;
    }
    .post-image {
      width: 100%;
      max-height: 500px;
      object-fit: cover;
    }
    .post-content {
      padding: 15px;
    }
    .post-caption {
      color: #333;
      margin-bottom: 10px;
      line-height: 1.4;
    }
    .post-likes {
      color: #666;
      font-size: 13px;
      font-weight: bold;
    }
    .error {
      background: #fee;
      color: #c33;
      padding: 15px;
      border-radius: 5px;
      margin: 10px 0;
    }
    .no-posts {
      text-align: center;
      padding: 40px 20px;
      color: #999;
    }
    .post-actions {
      display: flex;
      gap: 10px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #eee;
    }
    .post-actions a,
    .post-actions button {
      flex: 1;
      padding: 8px 12px;
      border: none;
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      text-align: center;
      font-size: 13px;
      font-weight: bold;
    }
    .btn-edit {
      background: #0061a3;
      color: white;
    }
    .btn-edit:hover {
      background: #004a7f;
    }
    .btn-delete {
      background: #dc3545;
      color: white;
      border: none;
    }
    .btn-delete:hover {
      background: #c82333;
    }
    .post-interactions {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 1px solid #eee;
      align-items: center;
    }
    .like-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 20px;
      padding: 5px;
      transition: transform 0.2s;
    }
    .like-btn:hover {
      transform: scale(1.2);
    }
    .like-btn.liked {
      color: #dc3545;
    }
    .like-count {
      color: #666;
      font-size: 13px;
      font-weight: bold;
      margin-left: auto;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>📸 Instagram Feed</h1>
      <div class="nav">
        <a href="/posts">Feed</a>
        <a href="/posts/upload">Upload Post</a>
        <a href="/posts/my-posts">My Posts</a>
        <a href="/auth/logout">Logout</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (posts.length === 0) { %>
      <div class="no-posts">
        <h2>No posts yet</h2>
        <p><a href="/posts/upload">Share your first post!</a></p>
      </div>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div class="post">
          <div class="post-header">
            <strong><%= post.username %></strong>
            <span><%= new Date(post.createdAt).toLocaleDateString() %></span>
          </div>
          <img src="<%= post.image %>" alt="post" class="post-image">
          <div class="post-content">
            <% if (post.caption) { %>
              <div class="post-caption"><strong><%= post.username %></strong> <%= post.caption %></div>
            <% } %>
            
            <div class="post-interactions">
              <% const likeArray = Array.isArray(post.likes) ? post.likes : []; %>
              <% const isLiked = likeArray.includes(userId); %>
              <button class="like-btn <%= isLiked ? 'liked' : '' %>" onclick="toggleLike('<%= post._id %>', this)">
                <%= isLiked ? '❤️' : '🤍' %>
              </button>
              <div class="like-count">
                <span id="likes-<%= post._id %>"><%= likeArray.length %></span> likes
              </div>
            </div>
            
            <% if (post.userId.toString() === userId) { %>
              <div class="post-actions">
                <a href="/posts/edit/<%= post._id %>" class="btn-edit">✏️ Edit</a>
                <button type="button" class="btn-delete" onclick="deletePost('<%= post._id %>')">🗑️ Delete</button>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <script>
    function toggleLike(postId, btn) {
      fetch(`/posts/like/${postId}`, {
        method: 'POST'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          btn.classList.toggle('liked');
          btn.textContent = data.liked ? '❤️' : '🤍';
          document.getElementById(`likes-${postId}`).textContent = data.likeCount;
        }
      })
      .catch(err => console.error('Error:', err));
    }

    function deletePost(postId) {
      if (confirm("Are you sure you want to delete this post?")) {
        fetch(`/posts/delete/${postId}`, {
          method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            alert("Failed to delete post: " + data.message);
          }
        })
        .catch(err => {
          console.error('Error:', err);
          alert('Error deleting post');
        });
      }
    }
  </script>
</body>
</html>
